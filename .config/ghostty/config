window-decoration = false
window-padding-x = 16
window-padding-y = 16
background-opacity = 0.78

gtk-single-instance=true
quit-after-last-window-closed=false

font-family = JetBrainsMono Nerd Font Mono

font-size = 14

theme = light:os1,dark:os1-night

# Pure prompt + Ghostty shell integration can render duplicate preprompt lines.
# Disable shell integration auto-injection to avoid duplicate "~" prompt rows.
shell-integration = none

keybind = shift+enter=text:\x1b\r
