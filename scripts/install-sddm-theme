#!/usr/bin/env bash
# Install the minimal SDDM theme and switch from autologin to a password
# prompt, so pam_gnome_keyring can unlock the login keyring.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
THEME_SRC="$DOTFILES_DIR/sddm/minimal"
THEME_DST="/usr/share/sddm/themes/minimal"

if [[ $EUID -ne 0 ]]; then
    exec sudo "$0" "$@"
fi

rm -rf "$THEME_DST"
install -d "$THEME_DST"
install -m 644 "$THEME_SRC"/* "$THEME_DST"/

install -d /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-theme.conf <<'CONF'
[Theme]
Current=minimal
CursorTheme=Adwaita
CursorSize=24
CONF

# /etc/sddm.conf overrides sddm.conf.d, so move an autologin config aside.
if [[ -f /etc/sddm.conf ]] && grep -q '^\[Autologin\]' /etc/sddm.conf; then
    mv /etc/sddm.conf /etc/sddm.conf.autologin.bak
    echo "Disabled autologin (moved /etc/sddm.conf to /etc/sddm.conf.autologin.bak)"
fi

echo "Installed SDDM theme 'minimal'. Takes effect on next boot."
